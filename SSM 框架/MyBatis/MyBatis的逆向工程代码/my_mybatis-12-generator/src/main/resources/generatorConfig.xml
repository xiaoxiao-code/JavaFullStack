<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<!-- MyBatis Generator 配置文件 -->
<generatorConfiguration>
    <!-- 上下文配置，targetRuntime="MyBatis3" 表示生成MyBatis3兼容的代码 -->
    <context id="DB2Tables" targetRuntime="MyBatis3">
        <!-- 插件：防止生成的XML文件被重复合并（避免覆盖手写代码） -->
        <plugin type="org.mybatis.generator.plugins.UnmergeableXmlMappersPlugin"/>

        <!-- 注释生成器配置：这里设置为不生成任何注释（suppressAllComments=true）也不生成日期注释 -->
        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <!-- 数据库连接配置：连接MySQL数据库 -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/mybatis_demo"
                        userId="root"
                        password="20060329">
        </jdbcConnection>

        <!-- Java模型（实体类）生成器：指定包名和源码目录 -->
        <javaModelGenerator targetPackage="lzt.mybatis.pojo" targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/> <!-- 根据表名启用子包 -->
            <property name="trimStrings" value="true"/>       <!-- 对字符串属性调用trim() -->
        </javaModelGenerator>

        <!-- SQL映射文件（XML）生成器：指定资源目录和包名 -->
        <sqlMapGenerator targetPackage="lzt.mybatis.mapper" targetProject="src/main/resources">
            <property name="enableSubPackages" value="true"/>
        </sqlMapGenerator>

        <!-- Mapper接口生成器：使用XML映射方式，指定接口包名和源码目录 -->
        <javaClientGenerator
                type="xmlMapper"
                targetPackage="lzt.mybatis.mapper"
                targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
        </javaClientGenerator>

        <!-- 数据库表映射：表名 t_car，生成的实体类名 Car -->
        <table tableName="t_car" domainObjectName="Car"/>

    </context>
</generatorConfiguration>